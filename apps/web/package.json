{
  "name": "@aicarnation/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build:companion": "vite build --mode companion --outDir ../../plugins/aicarnation/web --emptyOutDir"
  },
  "dependencies": {
    "@aicarnation/shared": "workspace:*",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
